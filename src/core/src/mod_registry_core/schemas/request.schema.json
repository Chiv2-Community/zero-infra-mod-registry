{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Chiv2-Community/zero-infra-mod-registry/prepare-v1/schemas/request.schema.json",
  "$ref": "#/$defs/request",
  "$defs": {
    "request": {
      "title": "RegistrationRequest", "type": "object", "required": ["action", "repo_url", "release_tag"],
      "properties": {
        "action": {"type": "string", "enum": ["add-package-release", "add-dll-release"]},
        "repo_url": {"type": "string", "pattern": "\\S"},
        "release_tag": {"type": "string", "pattern": "\\S"},
        "dll_file": {"type": "string", "pattern": "\\S"}
      }
    }
  }
}
