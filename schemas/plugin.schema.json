{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Chiv2-Community/zero-infra-mod-registry/prepare-v1/schemas/plugin.schema.json",
  "title": "DLL plugin metadata (plugin.json)",
  "type": "object",
  "required": ["name", "description", "authors"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string", "format": "uri"},
    "repo_url": {"$ref": "#/$defs/repository", "description": "Optional; the registry supplies the source repository URL. If provided, it must match that repository."},
    "name": {"$ref": "#/$defs/text"},
    "description": {"$ref": "#/$defs/text"},
    "authors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "target": {"type": "string", "enum": ["server", "client", "shared"], "default": "shared", "description": "Execution side for this DLL plugin: server-only, client-only, or shared by both. Omitted values default to shared. This is plugin metadata, not a pak manifest."},
    "icon_url": {"anyOf": [{"$ref": "#/$defs/mediaUrl"}, {"type": "null"}], "description": "Optional icon URL."},
    "image_urls": {"type": "array", "items": {"$ref": "#/$defs/mediaUrl"}, "default": [], "description": "Optional screenshot URLs."},
    "mod_dependencies": {"$ref": "#/$defs/dependencies", "default": [], "description": "Required pak mods, validated against package_db."},
    "plugin_dependencies": {"$ref": "#/$defs/pluginDependencies", "default": [], "description": "Required DLL plugins, validated against dll_db. The launcher requires explicit enablement and loads dependencies first."}
  },
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "repository": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_-]+/[A-Za-z0-9_-]+$"},
    "pakRepository": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_-]+/(?!\\.{1,2}$)[A-Za-z0-9_.-]+$"},
    "pluginDependencies": {"allOf": [{"$ref": "#/$defs/dependencies"}, {"items": {"properties": {"repo_url": {"$ref": "#/$defs/repository"}}}}]},
    "mediaUrl": {"type": "string", "format": "uri", "pattern": "^https://[^/@?#\\s]+(?:[/?#][^\\s]*)?$", "description": "HTTPS URL without embedded credentials."},
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "description": "At most one dependency per repository in each list; registry validation also checks case-insensitive repository uniqueness.",
      "items": {
        "type": "object",
        "required": ["repo_url", "version"],
        "properties": {
          "repo_url": {"$ref": "#/$defs/pakRepository"},
          "version": {
            "type": "string",
            "not": {"pattern": "^v?\\^.*,"},
            "pattern": "^(?:v?\\^|v?(?:>=|<=|==|!=|>|<)?)[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?(?:,\\s*(?:>=|<=|==|!=|>|<)?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?)*$",
            "description": "Semantic version, caret range, or comma-separated comparisons. Registry validation also parses SemVer and checks matching registered releases. Caret ranges cannot be combined with comparisons.",
            "examples": ["1.0.0", ">=1.0.0,<2.0.0", "^1.0.0"]
          }
        }
      }
    }
  }
}
